    },
    {
      "parameters": {
        "jsCode": "// Access the content object from the model's response\nconst content = $node[\"Message a model\"].json.choices[0].message.content;\n\n// Helper function to safely handle both arrays and strings\nconst safelyJoin = (data) => {\n  if (Array.isArray(data)) return data.join(\" | \");\n  return data || \"Not stated\";\n};\n\nreturn {\n  title: content.paper_metadata.title,\n  authors: content.paper_metadata.authors,\n  year: content.paper_metadata.year,\n  traditional_journey: content.journey_mapping.traditional_process_described,\n  intelligent_journey: content.journey_mapping.intelligent_shift_described,\n  autonomy_impact: content.theoretical_constructs.consumer_autonomy,\n  delegation_level: content.theoretical_constructs.delegation_level,\n  key_drivers: safelyJoin(content.theoretical_constructs.key_drivers),\n  study_type: content.empirical_evidence.study_type,\n  key_findings: safelyJoin(content.empirical_evidence.key_findings), \n  limitations: safelyJoin(content.empirical_evidence.limitations),\n  framework_relevance: content.framework_contribution.relevance_to_intelligent_journeys,\n  suggested_section: content.framework_contribution.suggested_section\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [544, -32],
      "id": "js-code",
      "name": "Code in JavaScript"
    },
