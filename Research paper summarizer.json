            "year": "={{ $json.year }}",
            "traditional_journey": "={{ $json.traditional_journey }}",
            "intelligent_journey": "={{ $json.intelligent_journey }}",
            "autonomy_impact": "={{ $json.autonomy_impact }}",
            "delegation_level": "={{ $json.delegation_level }}",
            "key_drivers": "={{ $json.key_drivers }}",
            "study_type": "={{ $json.study_type }}",
            "key_findings": "={{ $json.key_findings }}",
            "limitations": "={{ $json.limitations }}",
            "framework_relevance": "={{ $json.framework_relevance }}",
