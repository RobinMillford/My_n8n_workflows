# n8n Workflow Repository - .gitignore

# Environment variables and secrets
.env
.env.local
.env.*.local
*.key
*.pem
secrets.json
credentials.json

# n8n local data (if running n8n locally)
.n8n/
n8n-local/

# Temporary files
*.tmp
*.temp
*.log
.DS_Store
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Node modules (if using any Node.js tooling)
node_modules/
package-lock.json
yarn.lock

# Build artifacts
dist/
build/
*.pyc
__pycache__/

# Backup files
*.bak
*.backup
backup/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
