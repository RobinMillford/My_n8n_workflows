        "jsCode": "// 1. Get the data safely from the previous node (Create Row)\n// We use \"items[0].json\" to get the data fields\nconst topic = items[0].json.research_topic || \"Research_Report\";\nconst content = items[0].json.research_content || \"No content generated.\";\nconst datasets = items[0].json.additional_datasets || \"No datasets found.\";\n\n// 2. Combine them into one nice document\nconst fullReport = `\n# Research Report: ${topic}\n\n${content}\n\n---\n## Additional Datasets\n${datasets}\n`;\n\n// 3. Convert text to a binary file (Base64)\nconst binaryData = Buffer.from(fullReport).toString('base64');\n\n// 4. Return the binary file so Telegram can see it\nreturn {\n  json: items[0].json, // Pass through the original JSON data\n  binary: {\n    data: {\n      data: binaryData,\n      mimeType: 'text/markdown',\n      fileName: `${topic.replace(/[^a-z0-9]/gi, '_')}.md` // Clean filename\n    }\n  }\n};"
