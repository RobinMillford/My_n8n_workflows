    {
      "parameters": {
        "jsCode": "// 1. Get the input item\nconst item = items[0].json;\n\n// 2. Extract Data (Smart Fallbacks)\n// Topic: Look in 'research_topic' (DB) or 'topic' (Agent)\nconst topic = item.research_topic || item.topic || \"Research_Topic\";\n\n// Research Paper: Look in 'research_content'\nconst researchContent = item.research_content || \"No research paper content found.\";\n\n// Datasets: LOOK HERE FIRST -> 'additional_datasets' (DB) OR 'output' (Your Agent)\n// This line fixes your issue by grabbing the \"output\" field you showed me\nconst additionalDatasets = item.additional_datasets || item.output || \"No datasets found.\";\n\n// 3. Combine them into one text document\nconst fullReport = `\n# Research Report: ${topic}\n\n${researchContent}\n\n---\n## Additional Datasets\n${additionalDatasets}\n`;\n\n// 4. Create a clean filename starting with \"dataset_\"\n// Remove special characters to prevent errors\nconst cleanTopic = topic.replace(/[^a-z0-9]/gi, '_').substring(0, 30);\nconst fileName = `dataset_${cleanTopic}.md`; \n\n// 5. Convert to binary file (Base64) for Telegram\nconst binaryData = Buffer.from(fullReport).toString('base64');\n\n// 6. Return result\nreturn {\n  json: item,\n  binary: {\n    data: {\n      data: binaryData,\n      mimeType: 'text/markdown',\n      fileName: fileName\n    }\n  }\n};"
      },
